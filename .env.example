# Bu dosyayı ".env" adıyla kopyalayın ve doldurun. .env dosyasını kimseyle paylaşmayın.

# Brensyt'in sohbet/çeviri yapabilmesi için Claude API anahtarı (https://platform.claude.com)
ANTHROPIC_API_KEY=

# "Google ile bağlan" için Google Cloud Console'dan alınan OAuth istemci kimliği (isteğe bağlı)
# İzin verilen kaynak: http://localhost:5173
GOOGLE_CLIENT_ID=

PORT=5173
